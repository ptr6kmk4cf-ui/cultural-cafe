# ---- Core ----
# Local embedded DB started by `npm run db:start` (or your own PostgreSQL)
DATABASE_URL="postgresql://conversa:conversa_dev_password@localhost:5433/conversa"
# Direct (non-pooled) connection used by `prisma db push`. Same as DATABASE_URL locally.
# Hosted (e.g. Neon): DATABASE_URL = pooled string (host contains "-pooler"), DIRECT_URL = direct string.
DIRECT_URL="postgresql://conversa:conversa_dev_password@localhost:5433/conversa"
# Public origin of this web app (used for CSRF origin checks and Stripe redirects)
APP_URL="http://localhost:3000"
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# ---- AI provider (server-side only; never shipped to the extension) ----
# openai | anthropic | openai-compatible | mock
#   mock = offline canned responses for plumbing tests only (NOT real AI, clearly labelled in the UI)
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
# Optional: separate model for photo understanding (must support images)
AI_VISION_MODEL=""
# Only for openai-compatible (OpenRouter, Mistral, Together, local Ollama, …)
AI_BASE_URL=""

# ---- Storage ----
PHOTO_STORAGE_DIR="./storage/photos"

# ---- Billing (optional; billing stays disabled until these are set) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PREMIUM_PRICE_ID=""

# ---- Admin bootstrap: users registering with this email become ADMIN ----
ADMIN_EMAIL=""
SUPPORT_EMAIL="support@example.com"

# ---- Development only (ignored when NODE_ENV=production) ----
# Enables POST /api/dev/plan to switch your own plan FREE/PREMIUM for testing.
DEV_TOOLS="false"

# Optional: passwords for `npm run db:seed` (random ones are generated if unset)
SEED_DEMO_PASSWORD=""
SEED_ADMIN_PASSWORD=""
SEED_WORLD_PASSWORD=""

# Optional TURN for World P2P when both people are behind strict NATs.
# Signalling and translation still use this app; chat text still does not.
# WORLD_TURN_URL="turns:turn.example.com:443"
# WORLD_TURN_USERNAME=""
# WORLD_TURN_CREDENTIAL=""
